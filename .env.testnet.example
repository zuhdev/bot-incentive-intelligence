# Full-persistence testnet deployment. For a DB-free read-only preview, omit
# DATABASE_URL, DIRECT_DATABASE_URL, and REDIS_URL.
# Copy to .env for local testnet mode or set values in the deployment platform.
# This file contains placeholders only; use managed service credentials in production.
NODE_ENV="production"
BOT_NETWORK="testnet"
BOT_TESTNET_RPC_URL="https://rpc.bohr.life"
BOT_TESTNET_CHAIN_ID="968"
BOT_TESTNET_SCAN_API_URL="https://scan.bohr.life/api"
BOT_TESTNET_EXPLORER_URL="https://scan.bohr.life"

# Required production services. Supply real credentials through the hosting platform.
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/bot_intelligence?schema=public&sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_DB_HOST:5432/bot_intelligence?schema=public&sslmode=require"
REDIS_URL="redis://:PASSWORD@REDIS_HOST:6379"
NEXT_PUBLIC_APP_URL="https://YOUR_APP_DOMAIN"

# BDEX and DeFiLlama BOT Chain TVL are mainnet-only and are blocked in testnet mode.
BDEX_API_ENABLED="false"
BDEX_API_URL="https://dex-wallet.botchain.ai"
DEFILLAMA_API_URL="https://api.llama.fi"
DEFAULT_BOT_PROTOCOL_SLUG="bdex-v3"
INGEST_LOG_CHUNK="5000"
INGEST_BACKFILL_MAX_BLOCKS="50000"
