# ─────────────────────────────────────────────────────────────
# BOT Incentive Intelligence — environment configuration
# Copy to .env and fill in values. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Local development uses SQLite. Testnet deployment MUST use managed PostgreSQL.
# DATABASE_URL="postgresql://user:password@host:5432/bot_intelligence?schema=public&sslmode=require"
DATABASE_URL="file:./dev.db"
DIRECT_DATABASE_URL="file:./dev.db"

# ── BOT Chain network ───────────────────────────────────────
# Select exactly one network. Testnet activity is not mainnet incentive evidence.
BOT_NETWORK="mainnet"
BOT_MAINNET_RPC_URL="https://rpc.botchain.ai"
BOT_TESTNET_RPC_URL="https://rpc.bohr.life"
BOT_MAINNET_CHAIN_ID="677"
BOT_TESTNET_CHAIN_ID="968"
BOT_MAINNET_SCAN_API_URL="https://scan.botchain.ai/api"
BOT_TESTNET_SCAN_API_URL="https://scan.bohr.life/api"
BOT_MAINNET_EXPLORER_URL="https://scan.botchain.ai"
BOT_TESTNET_EXPLORER_URL="https://scan.bohr.life"

# ── External data providers ─────────────────────────────────
# BDEX public data is verified for mainnet only; never enable it in testnet mode.
BDEX_API_URL="https://dex-wallet.botchain.ai"
BDEX_API_ENABLED="true"
# DeFiLlama (public, no key required)
DEFILLAMA_API_URL="https://api.llama.fi"
# DeFiLlama protocol identifier for the project's TVL source (verified live: BDEX V3)
DEFAULT_BOT_PROTOCOL_SLUG="bdex-v3"

# Optional: CoinGecko API key (for higher rate limits)
# COINGECKO_API_KEY=""

# ── Queue / workers (optional) ──────────────────────────────
# When REDIS_URL is set, BullMQ is used for ingestion jobs.
# Without it, the built-in in-process scheduler is used (single-instance dev).
# REDIS_URL="redis://localhost:6379"

# ── Ingestion tuning ────────────────────────────────────────
# Block range per eth_getLogs request. The public RPC rejects/times out on
# large unfiltered ranges; filtered queries have been verified at 350k+ blocks.
INGEST_LOG_CHUNK="20000"
# Maximum blocks scanned per historical backfill run
INGEST_BACKFILL_MAX_BLOCKS="500000"

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="BOT Incentive Intelligence"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
