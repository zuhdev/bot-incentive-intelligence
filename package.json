{
  "name": "bot-incentive-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Independent BOT Chain ecosystem incentive monitoring, readiness and evidence platform. Not an official BOT Chain product.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:postgres": "npm run db:generate:postgres && next build",
    "vercel-build": "npm run build:postgres",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:prepare:postgres": "node scripts/prepare-postgres-schema.mjs",
    "db:generate:postgres": "npm run db:prepare:postgres && node scripts/generate-postgres-client.mjs",
    "db:deploy:postgres": "npm run db:prepare:postgres && prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:diff:postgres": "npm run db:prepare:postgres && node scripts/generate-postgres-migration.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "poc": "tsx scripts/poc/run-all.ts",
    "wallet:mainnet:create": "tsx scripts/create-mainnet-wallet.ts",
    "wallet:mainnet:balance": "tsx scripts/check-mainnet-wallet.ts",
    "wallet:testnet:create": "tsx scripts/create-testnet-wallet.ts",
    "wallet:testnet:balance": "tsx scripts/check-testnet-wallet.ts",
    "contract:mainnet:deploy": "tsx scripts/deploy-mainnet-evidence-anchor.ts",
    "contract:mainnet:verify": "tsx scripts/verify-mainnet-deployment.ts",
    "contract:testnet:deploy": "tsx scripts/deploy-evidence-anchor.ts",
    "contract:testnet:verify": "tsx scripts/verify-testnet-deployment.ts",
    "worker": "tsx workers/ingest.ts",
    "smoke:readonly": "tsx scripts/smoke/readonly-preview.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bullmq": "^5.58.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.37.8",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "prisma": "^6.16.2",
    "solc": "^0.8.38",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
