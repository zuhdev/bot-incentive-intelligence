# Full-persistence BOT mainnet deployment. For a DB-free read-only preview,
# omit DATABASE_URL, DIRECT_DATABASE_URL, and REDIS_URL.
# Copy to .env for local mainnet mode or set values in the deployment platform.
# This file contains placeholders only; use managed service credentials in production.
NODE_ENV="production"
BOT_NETWORK="mainnet"
BOT_MAINNET_RPC_URL="https://rpc.botchain.ai"
BOT_MAINNET_CHAIN_ID="677"
BOT_MAINNET_SCAN_API_URL="https://scan.botchain.ai/api"
BOT_MAINNET_EXPLORER_URL="https://scan.botchain.ai"

# Required production services. Supply real credentials through the hosting platform.
# Use a dedicated mainnet database and Redis; never share state with the testnet deployment.
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/bot_intelligence?schema=public&sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_DB_HOST:5432/bot_intelligence?schema=public&sslmode=require"
REDIS_URL="rediss://:PASSWORD@REDIS_HOST:6379"
NEXT_PUBLIC_APP_URL="https://YOUR_APP_DOMAIN"

# Mainnet providers. BDEX and DeFiLlama BOT Chain TVL are mainnet-only and are
# enabled in mainnet mode. Set BDEX_API_ENABLED="false" only to disable BDEX deliberately.
BDEX_API_ENABLED="true"
BDEX_API_URL="https://dex-wallet.botchain.ai"
DEFILLAMA_API_URL="https://api.llama.fi"
DEFAULT_BOT_PROTOCOL_SLUG="bdex-v3"

# Ingestion tuning. The public mainnet RPC rejects wide unfiltered eth_getLogs
# ranges; filtered chunked queries are documented in docs/connectivity-report.md.
INGEST_LOG_CHUNK="20000"
INGEST_BACKFILL_MAX_BLOCKS="500000"

# Optional: CoinGecko API key for higher rate limits.
# COINGECKO_API_KEY=""
